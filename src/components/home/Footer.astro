---
import Lion from '../Lion.astro';
---
<footer class="foot">
  <p>Thanks for stopping by.</p>
  <Lion pose="bed" class="foot-lion" />
</footer>
<style>
  .foot { text-align: center; padding: 28px 16px 0; margin-top: 40px; color: var(--ink); font: 700 17px/1.3 var(--font-hand); }
  .foot p { margin: 0 0 6px; }
  :global(.foot-lion) { width: 160px; }
</style>
