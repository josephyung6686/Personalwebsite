---
import { experience } from '../../data/experience';
---
<aside id="experience" class="rail" aria-labelledby="exp-h">
  <p class="num">EXPERIENCE</p>
  <h2 id="exp-h">Where I've worked</h2>
  <ul class="jobs panel">
    {experience.map((j) => (
      <li>
        <a class="job" href={`/work/${j.slug}`}>
          <span class="org">{j.org}</span>
          <span class="title">{j.title}</span>
          <span class="meta">{j.where} · {j.when}</span>
          <span class="go" aria-hidden="true">▶</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<style>
  .rail { position: sticky; top: 16px; padding-top: 48px; }
  h2 { font: 700 19px/1.15 var(--font-mono); letter-spacing: -.03em; line-height: 1.15; margin: 0 0 14px; color: var(--ink); }
  .jobs { list-style: none; margin: 0; padding: 6px; }
  .job { position: relative; display: block; padding: 12px 28px 12px 12px; border-radius: 0; text-decoration: none; transition: background .12s ease, translate .12s ease; }
  .job:hover { background: var(--panel-2); box-shadow: inset 0 0 0 2px var(--gold); }
  .job:active { translate: 2px 2px; }
  .job:focus-visible { outline: 3px solid var(--columbia); outline-offset: 1px; }
  .org { display: block; font-family: var(--font-mono); font-size: 14px; font-weight: 700; letter-spacing: -.02em; line-height: 1.25; color: var(--ink); }
  .title { display: block; margin-top: 3px; font-size: 13px; line-height: 1.3; color: var(--columbia); }
  .meta { display: block; margin-top: 3px; font-size: 12px; color: var(--muted); }
  .go { position: absolute; right: 12px; top: 50%; translate: 0 -50%; font-size: 9px; color: var(--gold); opacity: .55; transition: opacity .12s ease; }
  .job:hover .go { opacity: 1; }
  li + li { border-top: 2px dashed var(--panel-edge); }
  @media (max-width: 1100px) { .rail { position: static; padding-bottom: 8px; } }
</style>
