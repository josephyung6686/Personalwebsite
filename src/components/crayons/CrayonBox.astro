---
import './crayons.css';
import { COLORS, JUMPS } from './crayonList';
---
<nav id="crayon-box" class="cb" aria-label="Jump to a section with a crayon">
  <button type="button" class="cb-tab" aria-expanded="false" aria-controls="cb-panel"><i class="cb-tips" aria-hidden="true"></i><span>Crayons</span></button>
  <div id="cb-panel" class="cb-panel">
    <button type="button" id="draw-toggle" class="cb-draw" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.5 3.5l4 4L9 19l-5 1 1-5z" /><path d="M14 6l4 4" /></svg>Draw</button>
    <ul class="cb-tray">
      {JUMPS.map((c) => (
        <li><a class="cr" href={c.href} style={`--art:url(/wax/crayon-${c.art}.webp);--y:${c.y}px`}>{c.name}</a></li>
      ))}
    </ul>
    <i class="cb-carton" aria-hidden="true"><span>Crayons</span></i>
  </div>
</nav>

<div id="doodles" class="doodles" aria-hidden="true"></div>
<div id="draw-surface" class="draw-surface" hidden aria-hidden="true"><canvas></canvas></div>
<div id="draw-bar" class="draw-bar" role="toolbar" aria-label="Drawing" hidden>
  <p class="draw-tip">Pick a crayon and draw anywhere. He'll walk your line.</p>
  <div class="draw-picks" role="group" aria-label="Pick a crayon">
    {COLORS.map((c) => (
      <button type="button" class="pick" data-key={`crayon-${c.art}`} data-hex={c.hex} aria-label={`${c.color} crayon`} aria-pressed={c.art === 'red' ? 'true' : 'false'} style={`--art:url(/wax/pick-${c.art}.webp)`}></button>
    ))}
  </div>
  <div class="draw-acts">
    <button type="button" class="btn alt" data-draw="clear">Clear</button>
    <button type="button" class="btn" data-draw="done">Done drawing</button>
  </div>
</div>

<script>
  import { initCrayons } from './crayons';
  initCrayons();
</script>
