---
import Lion from '../Lion.astro';
import { site } from '../../data/site';
import birds from './birds.svg?raw';
import './hero.css';

const states = ['day', 'sunset', 'night'] as const;
const hide = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<header id="hero" class="hero" data-time="night">
  <div class="layer sky-layer" aria-hidden="true">
    {states.map((s) => <img class={`sky sky-${s}`} src={`/hero/sky-${s}.webp`} alt="" loading="lazy" />)}
  </div>
  <div class="layer sun-layer" aria-hidden="true"><img class="sun" src="/hero/sun.webp" alt="" loading="lazy" /></div>
  <div class="layer clouds-layer" aria-hidden="true">
    {states.map((s) => <img class={`clouds cl-${s}`} src={`/hero/clouds-${s}.webp`} alt="" loading="lazy" />)}
  </div>
  <div class="layer birds-layer" set:html={hide(birds)} />
  <div class="layer rays" aria-hidden="true"></div>
  <div class="layer night-layer" aria-hidden="true">
    <i class="stars tw1"></i><i class="stars tw2"></i><i class="stars tw3"></i>
    <img class="moon" src="/hero/moon.webp" alt="" loading="lazy" />
  </div>

  <nav class="hero-nav" aria-label="Main">
    <span>{site.location}</span>
    <span class="links"><a href="#about">About</a><a href="#work">Work</a><a href="#experience">Experience</a><a href="#wins">Wins</a></span>
  </nav>
  <h1>JOSEPH<br /> YUNG</h1>
  <p class="sub">{site.roles.join(' · ')}</p>
  <a class="prompt" href="#work">▶ VIEW WORK</a>

  <div class="px-scene" aria-hidden="true">
    {states.map((s) => (
      <picture>
        <source media="(max-width: 720px)" srcset={`/hero/scene-${s}-sm.webp`} />
        <img class={`scene scene-${s}`} src={`/hero/scene-${s}.webp`} alt="" loading="lazy" />
      </picture>
    ))}
    <img class="emissive" src="/hero/emissive.webp" alt="" loading="lazy" />
  </div>
  <div class="hero-lion">
    <Lion pose="laptop" class="lion" />
  </div>
</header>

<script>
  import { initHero } from './hero';
  initHero();
</script>
