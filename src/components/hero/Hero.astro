---
import Lion from '../Lion.astro';
import { site } from '../../data/site';
import sun from './sun.svg?raw';
import birds from './birds.svg?raw';
import nightsky from './nightsky.svg?raw';
import shadows from './shadows.svg?raw';
import './hero.css';

const states = ['day', 'sunset', 'night'] as const;
const hide = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<header id="hero" class="hero" data-time="night">
  <div class="layer sky-layer" aria-hidden="true">
    {states.map((s) => <img class={`sky sky-${s}`} src={`/hero/sky-${s}.png`} alt="" />)}
  </div>
  <div class="layer sun-layer" set:html={hide(sun)} />
  <div class="layer clouds-layer" aria-hidden="true">
    {states.map((s) => <img class={`clouds cl-${s}`} src={`/hero/clouds-${s}.png`} alt="" />)}
  </div>
  <div class="layer birds-layer" set:html={hide(birds)} />
  <div class="layer rays" aria-hidden="true"></div>
  <div class="layer night-layer" set:html={hide(nightsky)} />

  <nav class="hero-nav" aria-label="Main">
    <span>{site.location}</span>
    <span class="links"><a href="#work">Work</a><a href="#experience">Experience</a><a href="#wins">Wins</a><a href="#about">About</a></span>
  </nav>
  <h1>JOSEPH<br /> YUNG</h1>
  <p class="sub">{site.roles.join(' · ')}</p>
  <a class="prompt" href="#work">▶ VIEW WORK</a>

  <div class="px-scene" aria-hidden="true">
    {states.map((s) => <img class={`scene scene-${s}`} src={`/hero/scene-${s}.png`} alt="" />)}
    <Fragment set:html={hide(shadows)} />
    <img class="emissive" src="/hero/emissive.png" alt="" />
  </div>
  <div class="hero-lion">
    <Lion pose="laptop" class="lion" />
  </div>
</header>

<script>
  import { initHero } from './hero';
  initHero();
</script>
