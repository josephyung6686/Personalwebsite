const nav: [string | null, [string, string, string?][]][] = [
  ['Tuck', [['today', 'Today'], ['needs', 'Needs You'], ['brain', 'Tuck Brain'], ['chats', 'Chats'], ['diary', 'Diary']]],
  ['Your folder plan', [['edit', 'Edit Folders'], ['resort', 'Re-sort']]],
  ['Library', [['history', 'History'], ['tidy', 'Tidy Up', '881 MB']]],
];
---
<div class:list={['tuck-demo', size]} role="region" aria-label="Interactive demo of Tuck" tabindex="-1">
  <div class="td-win">
    <div class="td-side">
      <div class="td-lights" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="td-switch" aria-hidden="true">
        <span><Fragment set:html={I('folder')} /><b class="td-lbl">Finder</b></span>
        <span class="on"><Fragment set:html={I('sparkle')} /><b class="td-lbl">Tuck</b></span>
      </div>
      <div class="td-nav">
        {nav.map(([head, items]) => (
          <>
            <p class="td-navh">{head}</p>
            <ul>
              {items.map(([icon, label, note]) => (
                <li aria-current={icon === 'needs' ? 'page' : undefined}>
                  <Fragment set:html={I(icon)} /><span class="td-lbl">{label}</span>
                  {note && <small class="td-lbl td-note">{note}</small>}
                  {icon === 'needs' && <span class="td-count" data-count>{waitingCount(START)}<span class="td-vh"> waiting</span></span>}
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>
      <Fragment set:html={mascot('idle')} />
      <div class="td-prof"><span class="td-ava" aria-hidden="true">JY</span><span class="td-lbl"><b>Joseph</b><small>Student · AI on</small></span></div>
    </div>
    <div class="td-main">
      <div class="td-band"><b aria-hidden="true">Needs You</b><small>Prototype with sample files</small></div>
      <div class="td-panes">
        <section class="td-list" aria-label="Decisions" data-list set:html={renderList(START)}></section>
        <section class="td-detail" aria-label="Open decision" data-detail set:html={renderDetail(START)}></section>
      </div>
    </div>
  </div>
  <p class="td-vh" role="status" aria-live="polite" data-status></p>
</div>
<script>
  import { initTuckDemos } from './tuckDemo';
  initTuckDemos();
</script>
