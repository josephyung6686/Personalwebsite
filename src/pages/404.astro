---
import Base from '../layouts/Base.astro';
import Lion from '../components/Lion.astro';
---
<Base title="Nothing here yet · Joseph Yung">
  <main class="nf">
    <Lion pose="bed" class="nf-lion" />
    <h1>Nothing here yet.</h1>
    <p><a class="btn" href="/">Go back home</a></p>
  </main>
</Base>
<style>
  .nf { min-height: 80vh; display: grid; place-content: center; justify-items: center; text-align: center; padding: 24px; }
  :global(.nf-lion) { width: 180px; }
  h1 { font: 700 clamp(26px, 5vw, 36px)/1.15 var(--font-body); color: var(--ink); margin: 18px 0; -webkit-mask: url(/wax/grain.webp) 0 0 / 256px; mask: url(/wax/grain.webp) 0 0 / 256px; filter: url(#wax-edge); }
</style>
