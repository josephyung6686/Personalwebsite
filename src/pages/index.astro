---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import Captions from '../components/home/Captions.astro';
import Featured from '../components/home/Featured.astro';
import WorkGrid from '../components/home/WorkGrid.astro';
import Wins from '../components/home/Wins.astro';
import About from '../components/home/About.astro';
import ExperienceRail from '../components/home/ExperienceRail.astro';
import Footer from '../components/home/Footer.astro';
---
<Base title="Joseph Yung · Builds AI products, end to end">
  <Hero />
  <main id="work">
    <div class="home">
      <div class="home-main">
        <Captions />
        <About />
        <Featured />
        <WorkGrid />
        <Wins />
      </div>
      <ExperienceRail />
    </div>
  </main>
  <Footer />
</Base>
<style>
  /* Her single column, plus a sticky rail of jobs. Below 1100px the rail drops to its own section. */
  .home { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 28px; max-width: 1400px; margin: 0 auto; padding: 0 max(24px, calc(var(--box-room) - max(0px, (100vw - 1400px) / 2))) 0 24px; align-items: start; }
  .home-main :global(.wrap), .home-wide :global(.wrap) { max-width: none; padding-inline: 0; }
  .home-wide { max-width: 1400px; margin: 0 auto; padding: 0 max(24px, calc(var(--box-room) - max(0px, (100vw - 1400px) / 2))) 0 24px; }
  @media (max-width: 1100px) { .home { grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 1080px; } }
  @media (max-width: 480px) { .home, .home-wide { padding: 0 16px; } }
</style>
